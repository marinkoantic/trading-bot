# Optional overrides. Copy to .env only if you need them; .env is git-ignored.
# This project is PAPER_ONLY: it needs NO exchange API keys. Never put credentials here.
#
# Format: TB_<SECTION>__<KEY>=<value>
# TB_PROFILE=dev
# TB_RUN__SYMBOLS=LUNCUSDT,BTCUSDT
# TB_RUN__TIMEFRAME=5m
# TB_RISK__MAX_OPEN_POSITIONS=2
